# Copy to .env.local to use these locally. All optional for local development.
# Postgres connection string. Without it the app uses an embedded database in .data/
DATABASE_URL=
# Resend (https://resend.com). Without these, emails are printed to the terminal.
RESEND_API_KEY=
EMAIL_FROM=
# Public base URL used in email links, e.g. https://coperto.it
APP_URL=
# Any long random text; Vercel Cron sends it, so only the morning job can trigger reminders.
CRON_SECRET=
